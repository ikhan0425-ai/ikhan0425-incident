{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "typeRoots": ["../node_modules/@types"]
  },
  "include": ["../appdeploy/backend", "./types/appdeploy-sdk.d.ts"]
}
